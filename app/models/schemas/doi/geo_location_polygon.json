{
  "title": "GeoLocationPolygon",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "array",
	"items": {
		"type": "object",
		"oneOf": [
			{
				"required": [
					"polygonPoint"
				],
				"properties": {
					"polygonPoint": {
						"$ref": "polygon_point.json"
					}
				},
				"additionalProperties": false
			},
			{
				"required": [
					"inPolygonPoint"
				],
				"properties": {
					"inPolygonPoint": {
						"$ref": "in_polygon_point.json"
					}
				},
				"additionalProperties": false
			}
		]
	},
	"allOf": [
		{
			"contains": {
				"required": [
					"polygonPoint"
				]
			},
			"minContains": 4
		},
		{
			"contains": {
				"required": [
					"inPolygonPoint"
				]
			},
			"minContains": 0,
			"maxContains": 1
		}
	]
}

